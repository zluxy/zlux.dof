  <ItemGroup>
    <!-- CUDA gather kernel. nvcc emits an .obj that the linker picks up through
         AdditionalDependencies above. -Xcompiler /MD is REQUIRED: nvcc defaults
         to /MT and the mismatch fails the link with LNK2038.
         zluxDOF is distributed publicly, so the kernel ships as a fat binary
         covering every architecture CUDA 13.x supports:
           sm_75  Turing    RTX 20xx, GTX 16xx
           sm_80  Ampere    A100
           sm_86  Ampere    RTX 30xx
           sm_89  Ada       RTX 40xx
           sm_90  Hopper    H100
           sm_120 Blackwell RTX 50xx
         Plus compute_120 PTX so future architectures JIT rather than falling
         back to the CPU. CUDA 13 cannot target anything below sm_75, so Pascal
         (GTX 10xx) users get the CPU path; moving to CUDA 12.9 would cover them. -->
    <CustomBuild Include="..\zluxDOF_Kernel.cu">
      <FileType>Document</FileType>
      <Command>"$(CUDA_SDK_BASE_PATH)\bin\nvcc.exe" -c "%(FullPath)" -o "$(IntDir)zluxDOF_Kernel.obj" --use-local-env -O3 -m64 -std=c++17 -gencode arch=compute_75,code=sm_75 -gencode arch=compute_80,code=sm_80 -gencode arch=compute_86,code=sm_86 -gencode arch=compute_89,code=sm_89 -gencode arch=compute_90,code=sm_90 -gencode arch=compute_120,code=sm_120 -gencode arch=compute_120,code=compute_120 -Xcompiler /MD</Command>
      <Outputs>$(IntDir)zluxDOF_Kernel.obj</Outputs>
      <Message>nvcc zluxDOF_Kernel.cu (sm_120)</Message>
    </CustomBuild>
  </ItemGroup>
