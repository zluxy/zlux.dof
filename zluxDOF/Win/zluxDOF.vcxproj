    <ClCompile>
      <Optimization>MaxSpeed</Optimization>
      <!-- zluxDOF is a CPU-bound, transcendental-heavy gather kernel. The
           following flags do not change the algorithm, only how aggressively
           the compiler lowers it to machine code:
             IntrinsicFunctions (/Oi)            inline sqrt/exp/pow as intrinsics
             FavorSizeOrSpeed=Speed (/Ot)        prefer faster code over smaller
             InlineFunctionExpansion=AnySuitable (/Ob2) aggressive inlining
             EnableEnhancedInstructionSet=AVX2   vectorize the double math
             FloatingPointModel=Fast (/fp:fast)  reassociate FP; NaN guards in
                                                 the source still hold under MSVC
             FunctionLevelLinking (/Gy) + WPO/LTCG  whole-program optimization
           AVX2 is safe on the build/target machine (Zen 5 / Ryzen 9950X3D); a
           .aex built this way requires an AVX2-capable CPU (≈2014+) to load. -->
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <FavorSizeOrSpeed>Speed</FavorSizeOrSpeed>
      <InlineFunctionExpansion>AnySuitable</InlineFunctionExpansion>
